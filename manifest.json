{
  "manifest_version": 3,
  "name": "Flow Tab - 极简新标签页",
  "version": "1.0.0",
  "description": "极简新标签页",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "history",
    "topSites"
  ],
  "host_permissions": [
    "https://suggestion.baidu.com/*",
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*"
  ]
}
