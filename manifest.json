{
  "manifest_version": 3,
  "name": "Flow Tab - 极简智能新标签页",
  "version": "1.0.0",
  "description": "极简现代风 Chrome 新标签页，融合温暖光晕美学、斜杠妙招快捷指令、AI 智能助手与全能导航工具。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "history",
    "topSites"
  ]
}
